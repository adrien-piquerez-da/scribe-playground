module Model where

import DA.Action
import DA.Foldable

data BlobView = BlobView { }

interface Blob where viewtype BlobView

template Seed
  with owner: Party
  where
    signatory owner

    nonconsuming choice CreateMany: ([ContractId Blob])
      with
        a: Int
        b: Int
        c: Int
        d: Int
        e: Int
        f: Int
        g: Int
        h: Int
      controller owner
      do 
        as <- replicateA a (fmap coerceContractId (create (BlobA owner)))
        bs <- replicateA b (fmap coerceContractId (create (BlobB owner)))
        cs <- replicateA c (fmap coerceContractId (create (BlobC owner)))
        ds <- replicateA d (fmap coerceContractId (create (BlobD owner)))
        es <- replicateA e (fmap coerceContractId (create (BlobE owner)))
        fs <- replicateA f (fmap coerceContractId (create (BlobF owner)))
        gs <- replicateA g (fmap coerceContractId (create (BlobG owner)))
        hs <- replicateA h (fmap coerceContractId (create (BlobH owner)))
        return $ as ++ bs ++ cs ++ ds ++ es ++ fs ++ gs ++ hs

    nonconsuming choice ArchiveMany: ()
      with contracts: [ContractId Blob]
      controller owner
      do mapA_ archive contracts

template BlobA
  with owner: Party
  where
    signatory owner

    interface instance Blob for BlobA where
      view = BlobView

template BlobB
  with owner: Party
  where
    signatory owner

    interface instance Blob for BlobB where
      view = BlobView

template BlobC
  with owner: Party
  where
    signatory owner

    interface instance Blob for BlobC where
      view = BlobView

template BlobD
  with owner: Party
  where
    signatory owner

    interface instance Blob for BlobD where
      view = BlobView

template BlobE
  with owner: Party
  where
    signatory owner

    interface instance Blob for BlobE where
      view = BlobView


template BlobF
  with owner: Party
  where
    signatory owner

    interface instance Blob for BlobF where
      view = BlobView

template BlobG
  with owner: Party
  where
    signatory owner

    interface instance Blob for BlobG where
      view = BlobView

template BlobH
  with owner: Party
  where
    signatory owner

    interface instance Blob for BlobH where
      view = BlobView

template NamedBlob
  with
    name: Text
    owner: Party
  where signatory owner
